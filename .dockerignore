# Build context for the prod api image is the repo root (see
# setup/docker/docker-compose.prod.yml). Exclude local state and
# dev-only/secret files so they are never sent to the docker daemon.
.git
.gitignore
data
db
.venv
frontend
container-shared-volume
docs
.env
.env.*
__pycache__
*.pyc
*.pyo
*.egg-info
.pytest_cache
.ruff_cache
.mypy_cache
.DS_Store
