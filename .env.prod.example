# ================================
# PLM-IQ unified environment file
# ================================




#Siemens API settings
LLM_BASE_URL=https://api.siemens.com/llm/v1
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIMENSIONS=1024
RERANKER_MODEL=qwen3-reranker-0.6b
ASSISTANT_MODEL=deepseek-v4-flash
VISION_MODEL=deepseek-v4-flash

# open router settings
LLM_BASE_URL=https://openrouter.ai/api/v1
CHAT_MODEL=deepseek-v4-flash
EMBEDDING_MODEL=baai/bge-m3
EMBEDDING_DIMENSIONS=1024
RERANKER_MODEL=qwen3-reranker-0.6b
ASSISTANT_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
VISION_MODEL=deepseek-v4-flash

# Elasticsearch
ES_HOST=http://localhost:9200
ES_USER=elastic
ES_PASSWORD=elastic
ELASTICSEARCH_VERSION=8.15.0
ELASTICSEARCH_DATA_DIR=./data/elasticsearch
ELASTICSEARCH_HTTP_PORT=9200

# Gitea (Git CAD file storage)
GITEA_BASE_URL=http://localhost:3000
GITEA_OWNER=plmiquser
GITEA_REPO=plm-iq-gitrepo
GITEA_USERNAME=plmiquser
GITEA_PASSWORD=plmiqplmiq
GITEA_BRANCH=main
GITEA_COMMIT_EMAIL=plm-iq@localhost
GITEA_VERSION=1.22
GITEA_DATA_DIR=./data/gitea
GITEA_HTTP_PORT=3000
GITEA_SSH_PORT=2222
GITEA_ADMIN_EMAIL=admin@localhost
GITEA_ADMIN_FULL_NAME=PLM-IQ Administrator
GITEA_REPO_PRIVATE=false
GITEA_UID=1000
GITEA_GID=1000

# Mailpit SMTP web UI / data
MAILPIT_VERSION=latest
MAILPIT_UI_PORT=8025
MAILPIT_DATA_DIR=./data/mailpit

# Project root (absolute path to this repo). buildrun.bat sets it
# automatically from bin\..; set it manually only for direct compose calls.
PLMIQ_ROOT=C:/path/to/plm-iq

# Compose project name; containers become plm-iq-cont-gitea-1 and plm-iq-cont-elasticsearch-1
COMPOSE_PROJECT_NAME=plm-iq-cont
COMPOSE_NETWORK_NAME=plm-iq-network

# Upload and vision limits
MAX_UPLOAD_SIZE_MB=10
VISION_MAX_IMAGE_DIMENSION=4096
VISION_MAX_TOKENS=4096
VISION_TIMEOUT_SECONDS=180

# App settings
APP_TITLE=PLM-IQ
APP_DESCRIPTION=PLM-IQ - Parts, BOM, Costing, ECO, AML/AVL, CAD Metadata
APP_VERSION=1.0.0
LOG_LEVEL=INFO
DATABASE_URL=sqlite:///db/plm-iq.db
SECRET_KEY=arandomstring
VOLUME_DIR=data/volume
DOCUMENTS_GITEA_REPO=plm-iq-documents
BASE_DOMAIN=localhost
VERIFY_TOKEN_MAX_AGE_MINUTES=60
TENANT_REQUIRE_SUBDOMAIN=false
QUERY_MAX_ROWS=1000
QUERY_TIMEOUT_SECONDS=30
# SMTP via the local Mailpit container (docker-compose "smtp" service).
# Mailpit accepts mail on 127.0.0.1:1025 (no auth, no TLS) and its web UI
# is on http://localhost:8025. Disable (SMTP_ENABLED=false) to use a real server.
SMTP_ENABLED=true
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=plm-iq@localhost
SMTP_TLS=false
DEFAULT_PAGE_SIZE=25
DOC_ALLOWED_EXTENSIONS=.pdf,.doc,.docx,.xls,.xlsx,.ppt,.pptx,.txt,.md,.csv,.json,.xml,.html,.htm,.png,.jpg,.jpeg,.gif,.svg,.webp,.zip,.7z,.tar,.gz,.step,.stp,.dwg,.dxf,.sldprt,.sldasm,.stl,.3mf,.iges,.igs,.catpart,.catproduct,.x_t,.x_b,.prt,.asm

# ── aisearch configuration ─────────────────────────────────────
INDEX_PARTS=plm_parts
INDEX_BOM=plm_bom
INDEX_COSTING=plm_costing
INDEX_ECO=plm_eco
INDEX_AML=plm_aml
INDEX_AVL=plm_avl
INDEX_CAD=plm_cad
INDEX_DOCS=plm_docs
ALL_INDICES=plm_parts,plm_bom,plm_costing,plm_eco,plm_aml,plm_avl,plm_cad,plm_docs
SEARCH_DEFAULT_SIZE=10
SEARCH_MAX_SIZE=50
RAG_MAX_CONTEXT_DOCS=10
MAX_EMBED_CHARS=4000
BULK_BATCH_SIZE=500
SEARCH_BACKEND=elasticsearch
DB_PATH=db/plm-iq.db
SEARCH_VOLUME_DIR=data/volume
SEARCH_STAGING_DIR=data/index_staging
UPLOAD_DIR=data/uploads

# Assistant configuration
MAX_TOOL_ROUNDS=10
MAX_HISTORY_TURNS=10
MAX_SESSIONS=1000