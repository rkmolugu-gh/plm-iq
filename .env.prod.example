# PLM-IQ production environment
APP_TITLE=PLM-IQ
APP_DESCRIPTION=AI-Native Product Lifecycle Management
APP_VERSION=0.1.0
LOG_LEVEL=INFO

# SaaS domain
BASE_DOMAIN=plm-iq.com
TENANT_REQUIRE_SUBDOMAIN=true

# PostgreSQL
POSTGRES_VERSION=16
POSTGRES_USER=plmiq
POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM_VALUE
POSTGRES_DB=plmiq
DATABASE_URL=postgresql+psycopg://plmiq:CHANGE_ME_LONG_RANDOM_VALUE@postgres:5432/plmiq

# Application secret
SECRET_KEY=CHANGE_ME_LONG_RANDOM_VALUE

# Elasticsearch
ELASTICSEARCH_VERSION=8.15.0
ES_PASSWORD=CHANGE_ME_LONG_RANDOM_VALUE
ES_JAVA_OPTS=-Xms1g -Xmx1g

# Gitea
GITEA_VERSION=1.22
GITEA_BASE_URL=https://git.plm-iq.com
GITEA_OWNER=CHANGE_ME
GITEA_REPO=CHANGE_ME
GITEA_USERNAME=CHANGE_ME
GITEA_PASSWORD=CHANGE_ME
GITEA_BRANCH=main
GITEA_COMMIT_EMAIL=plm-iq@plm-iq.com
DOCUMENTS_GITEA_REPO=CHANGE_ME

# Storage
VOLUME_DIR=/app/data
DOWNLOADS_CACHE_DIR=/app/data/downloads

# Query/report limits
QUERY_MAX_ROWS=10000
QUERY_TIMEOUT_SECONDS=30
DEFAULT_PAGE_SIZE=50

# Documents
DOC_ALLOWED_EXTENSIONS=pdf,txt,md,csv,docx,xlsx,png,jpg,jpeg

# Email
SMTP_ENABLED=true
SMTP_HOST=CHANGE_ME
SMTP_PORT=587
SMTP_USER=CHANGE_ME
SMTP_PASSWORD=CHANGE_ME
SMTP_FROM=PLM-IQ <noreply@plm-iq.com>
SMTP_TLS=true

# Caddy / ACME
ACME_EMAIL=CHANGE_ME
CLOUDFLARE_API_TOKEN=CHANGE_ME

# Docker image
PLM_IQ_IMAGE=plm-iq:prod
