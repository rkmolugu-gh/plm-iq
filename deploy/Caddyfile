{
    email {$ACME_EMAIL}
    # Production access logging, rotated.
    log {
        output file /data/plm-iq-access.log {
            roll_size 100MiB
            roll_keep 5
        }
    }
}

# ── Common config shared by every active site ─────────────────────────
# Compression, hardened response headers, and the app upstream.
# NOTE: the app's tenant resolver maps  <tenant>.<BASE_DOMAIN>  -> tenant
# (see app/routers/auth.py -> resolve_tenant). For the tenant wildcard
# below to resolve tenants, production BASE_DOMAIN MUST be
# "discreet.plm-iq.com" (NOT "plm-iq.com"), otherwise every tenant
# request silently falls through as no-tenant.
(common) {
    encode gzip zstd
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
    }
    reverse_proxy api:8000
}

# Apex application.
plm-iq.com {
    import common
}

# API hostname.
api.plm-iq.com {
    import common
}

# Tenant-base hostname (the bare domain tenant subdomains hang off).
# Required so requests to discreet.plm-iq.com itself are served instead
# of Caddy's 404. Sets BASE_DOMAIN=discreet.plm-iq.com in production.
discreet.plm-iq.com {
    import common
}

# Tenant hostnames.
# Requires DNS-01 support because this is a wildcard certificate:
#   *.discreet.plm-iq.com  ->  CLOUDFLARE_API_TOKEN (Zone DNS:Edit only)
*.discreet.plm-iq.com {
    tls {
        dns cloudflare {env.CLOUDFLARE_API_TOKEN}
    }
    import common
}

