APP_TITLE=PLM-IQ
APP_DESCRIPTION=AI-Native Product Lifecycle Management
APP_VERSION=0.1.0
LOG_LEVEL=DEBUG

BASE_DOMAIN=localhost
TENANT_REQUIRE_SUBDOMAIN=false

POSTGRES_USER=plmiq
POSTGRES_PASSWORD=plmiq
POSTGRES_DB=plmiq
DATABASE_URL=postgresql+psycopg://plmiq:plmiq@postgres:5432/plmiq

SECRET_KEY=dev-only-change-me

ELASTICSEARCH_VERSION=8.15.0
ES_PASSWORD=elastic
ES_JAVA_OPTS=-Xms512m -Xmx512m

GITEA_VERSION=1.22
GITEA_BASE_URL=http://localhost:3000
GITEA_OWNER=plmiq
GITEA_REPO=plmiq
GITEA_USERNAME=dev
GITEA_PASSWORD=dev
GITEA_BRANCH=main
GITEA_COMMIT_EMAIL=dev@localhost
DOCUMENTS_GITEA_REPO=documents

VOLUME_DIR=/app/data
DOWNLOADS_CACHE_DIR=/app/data/downloads

QUERY_MAX_ROWS=10000
QUERY_TIMEOUT_SECONDS=30
DEFAULT_PAGE_SIZE=50

DOC_ALLOWED_EXTENSIONS=pdf,txt,md,csv,docx,xlsx,png,jpg,jpeg

SMTP_ENABLED=true
SMTP_HOST=smtp
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=PLM-IQ <noreply@localhost>
SMTP_TLS=false
