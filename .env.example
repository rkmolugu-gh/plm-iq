# PLM-IQ Environment Configuration
# Copy this file to .env and update with your values

# ============================================
# APPLICATION SETTINGS
# ============================================

# Application environment
APP_ENV=development  # development, staging, production
DEBUG=true
SECRET_KEY=your-secret-key-here-change-in-production

# Server settings
HOST=0.0.0.0
PORT=8000
WORKERS=4

# ============================================
# DATABASE SETTINGS
# ============================================

# PostgreSQL connection
DATABASE_URL=postgresql://user:password@localhost:5432/plm_iq

# Database pool settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# ============================================
# ELASTICSEARCH SETTINGS
# ============================================

# Elasticsearch connection
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_INDEX=plm_iq

# ============================================
# AI/LLM SETTINGS
# ============================================

# OpenAI API
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Anthropic API (optional)
ANTHROPIC_API_KEY=your-anthropic-api-key

# Local LLM settings (optional)
LOCAL_LLM_ENABLED=false
LOCAL_LLM_URL=http://localhost:11434

# Embedding settings
EMBEDDING_DIMENSION=1536
VECTOR_DB_PATH=./data/vectors

# ============================================
# FILE STORAGE SETTINGS
# ============================================

# Upload directory
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_SIZE=104857600  # 100MB

# Allowed file types
ALLOWED_EXTENSIONS=.pdf,.dwg,.step,.stp,.iges,.igs,.stl,.obj,.py,.txt,.doc,.docx

# ============================================
# AUTHENTICATION SETTINGS
# ============================================

# JWT settings
JWT_SECRET_KEY=your-jwt-secret-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Password settings
PASSWORD_MIN_LENGTH=8
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_NUMBERS=true
PASSWORD_REQUIRE_SPECIAL=true

# ============================================
# EMAIL SETTINGS (Optional)
# ============================================

# SMTP configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_TLS=true

# Email notifications
EMAIL_NOTIFICATIONS_ENABLED=false
EMAIL_FROM=plm-iq@yourdomain.com

# ============================================
# LOGGING SETTINGS
# ============================================

# Log level
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_FILE=./logs/plm_iq.log
LOG_ROTATION=midnight
LOG_RETENTION=30  # days

# ============================================
# CACHE SETTINGS
# ============================================

# Redis cache (optional)
REDIS_URL=redis://localhost:6379
CACHE_ENABLED=true
CACHE_TTL=3600  # seconds

# ============================================
# FEATURE FLAGS
# ============================================

# Enable/disable features
ENABLE_AI_FEATURES=true
ENABLE_VECTOR_SEARCH=true
ENABLE_KNOWLEDGE_GRAPH=false
ENABLE_AUDIT_LOG=true

# ============================================
# CORS SETTINGS
# ============================================

# Allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# ============================================
# MONITORING SETTINGS
# ============================================

# Prometheus metrics
ENABLE_METRICS=false
METRICS_PORT=9090

# Sentry (optional)
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# ============================================
# INTEGRATION SETTINGS
# ============================================

# CAD tools integration (optional)
ENABLE_CAD_INTEGRATION=false
AUTODESK_FORGE_CLIENT_ID=
AUTODESK_FORGE_CLIENT_SECRET=

# ERP integration (optional)
ENABLE_ERP_INTEGRATION=false
ERP_API_URL=
ERP_API_KEY=

# ============================================
# DEVELOPMENT SETTINGS
# ============================================

# Enable development features
ENABLE_SWAGGER=true
ENABLE_REDOC=true
ENABLE_PROMETHEUS=false

# Mock external services (for testing)
MOCK_AI_SERVICE=false
MOCK_EMAIL_SERVICE=false
