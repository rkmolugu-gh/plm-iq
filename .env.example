# PLM-IQ sample environment
DATABASE_URL=postgresql://user:pass@localhost:5432/plmiq
SECRET_KEY=change-me
PROFILE_STORAGE=local

# Editions: comma-separated codes; drives gateway host routing and the static site build
EDITIONS=foundation,discrete,process,food

# Search indexing (community-edition Elasticsearch, basic-license APIs only).
# Tenant-rooted naming: files <tenant-slug>-graph-index-<ts>.ndjson under
# database/index; Elasticsearch indices <tenant-slug>-vertices / -edges.
ELASTICSEARCH_URL=http://localhost:9200
# Optional auth: defaults resolve to ES_USER/ES_PASSWORD (setup/.env; the
# docker stack provisions ES_USER as a superuser via elasticsearch-init),
# then elastic / ELASTIC_PASSWORD. Set ELASTICSEARCH_API_KEY for key auth.
ELASTICSEARCH_API_KEY=
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=
ELASTICSEARCH_TIMEOUT=30
# Intermediate index files land in <repo>/database/index unless overridden
INDEX_DIR=
